{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "example-automations",
  "description": "Example plugin that ships a script with dependencies, a scheduled workflow, a skill, always-on instructions and config fields. Copy it to start a plugin that runs code in the project sandbox.",
  "author": {
    "name": "Subbly",
    "url": "https://www.subbly.co"
  },
  "extensions": {
    "co.subbly.builder": {
      "displayName": "Example: workflows and scripts",
      "image": "cover.webp",
      "fields": [
        {
          "key": "GREETING",
          "label": "Greeting",
          "type": "text",
          "required": true
        },
        {
          "key": "API_KEY",
          "label": "API key",
          "type": "text",
          "secret": true
        },
        {
          "key": "TONE",
          "label": "Tone",
          "type": "select",
          "options": ["friendly", "formal"]
        }
      ]
    }
  }
}
