{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "example-contentful",
  "description": "Manage Contentful content from the builder: search and edit entries, content types, assets, and locales through Contentful's hosted MCP server. Connects with your Contentful account via OAuth.",
  "extensions": {
    "co.subbly.builder": {
      "displayName": "Example: Contentful",
      "image": "cover.webp",
      "connectors": {
        "contentful": {
          "auth": "oauth",
          "tools": [
            "get_initial_context",
            "search_entries",
            "semantic_search",
            "get_entry",
            "create_entry",
            "update_entry",
            "publish_entry",
            "unpublish_entry",
            "list_content_types",
            "get_content_type",
            "list_assets",
            "get_asset",
            "upload_asset",
            "update_asset",
            "publish_asset",
            "unpublish_asset",
            "list_locales",
            "list_tags"
          ]
        }
      }
    }
  }
}
